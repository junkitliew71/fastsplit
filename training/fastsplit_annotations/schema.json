{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastsplit.local/schemas/receipt-annotation-v1.json",
  "title": "FastSplit receipt semantic annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "split", "source", "status", "assignments", "items", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "minLength": 1 },
    "split": { "enum": ["train", "test"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "boxes", "entities"],
      "properties": {
        "image": { "type": "string" },
        "boxes": { "type": "string" },
        "entities": { "type": "string" }
      }
    },
    "status": { "enum": ["draft", "complete", "skipped", "unclear"] },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "tokenIds", "text"],
        "properties": {
          "id": { "type": "string" },
          "label": {
            "enum": ["ITEM_NAME", "QUANTITY", "UNIT_PRICE", "LINE_TOTAL", "SUBTOTAL", "SERVICE_CHARGE", "TAX", "DISCOUNT", "ROUNDING", "GRAND_TOTAL", "OTHER"]
          },
          "tokenIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^t[0-9]{4,}$" }
          },
          "text": { "type": "string" },
          "itemId": { "type": "string" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assignmentIds"],
        "properties": {
          "id": { "type": "string" },
          "assignmentIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "notes": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
